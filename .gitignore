# KubeArmor
# NOTE: anchored to the build-output path. An unanchored "kubearmor" also matches
# the KubeArmor/ source directory on case-insensitive filesystems (macOS), which
# would ignore every untracked file under it.
/KubeArmor/kubearmor
karmor
snitch
kubearmor-operator
snitch-cmd

# KubeArmor YAML Generator
deploygen

# contribution
.vscode
.idea

# vagrant
.vagrant
contribution/vagrant/*.log

# packages
*.deb
*.rpm
.coverprofile

# object files
**/BPF/**/*.o

# kernel header
vmlinux.h

# ignore list
**/ignore.lst
**/syscheck
**/cflags.lst

# gingko test tmp file
**/*.test

#ignore go.work
go.work
go.work.sum

# ignore hook and related binaries
hook
deployHook

# allow hook directory
!**/hook/

# personal scratchpad for incubation reapplication work — not for upstream
MEMORY.md
